# Copy to /etc/enquiries.env and fill in. Keep it private: sudo chmod 600 /etc/enquiries.env
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
DATA_DIR=/var/lib/enquiries
APP_URL=https://enquiries.raresquaredlabs.co.uk
ADMIN_PASSWORD=change-this-to-something-long
# Long random string — generate with: openssl rand -hex 32
# Back it up: it encrypts stored mailbox passwords and the AI key.
APP_SECRET=
