# Port the web server listens on
PORT=3000
# Address to listen on. Use 127.0.0.1 when nginx sits in front
HOST=0.0.0.0
# Password for the /admin area (where you set up businesses). If unset, one is
# generated on first run and saved to data/admin-password.txt
ADMIN_PASSWORD=change-me
# Secret used to sign logins and encrypt stored inbox passwords. If unset, one is
# generated and saved to data/secret.key — keep that file safe and backed up.
APP_SECRET=
# Where the SQLite database and keys are stored
DATA_DIR=./data
